{
  "manifest_version": 2,
  "version": "1.1.0",
  "id": "github.elmeir.knowledge-base",
  "name": "知识库",
  "description": "自带萌娘百科与 Bangumi 离线资料库，注册 search_knowledge / search_bangumi / get_bangumi_season / browse_bangumi 工具供 LLM 按需查询与筛选。",
  "author": {
    "name": "Elmeir",
    "url": "https://github.com/Elmeir"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Elmeir/maibot-plugin-knowledge-base",
    "homepage": "https://github.com/Elmeir/maibot-plugin-knowledge-base",
    "documentation": "https://github.com/Elmeir/maibot-plugin-knowledge-base#readme",
    "issues": "https://github.com/Elmeir/maibot-plugin-knowledge-base/issues"
  },
  "host_application": {
    "min_version": "1.2.4",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.8.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "jieba",
      "version_spec": ">=0.42.1"
    }
  ],
  "capabilities": [
    "send.text"
  ],
  "plugin_type": "data",
  "display": {
    "icon": {
      "type": "emoji",
      "value": "📚"
    }
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
